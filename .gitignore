# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large source assets kept out of the build (see reference-assets/README.md)
/reference-assets/*.glb

# Local Cloudflare state from `wrangler dev`
.wrangler/
/reference-assets/audio/

# wrangler dev secrets (GOOGLE_CLIENT_SECRET, TURNSTILE_SECRET): never commit
.dev.vars*

# Blender: Python bytecode and autosave backups
__pycache__/
*.blend1
