# Normalise line endings in the repository, but leave the working copy native — this is a
# Windows machine and forcing LF on checkout would be a surprise for no gain.
#
# This comes FIRST on purpose: later rules win in .gitattributes, so the binary declarations
# below must not be overridden by it. A `text` attribute on a .glb would have git rewriting
# line endings inside the model and corrupting it.
* text=auto

# Binary art goes through Git LFS: the models alone are ~250 MB, and git slows to a crawl once
# large binaries are in its object store. LFS keeps pointers in the history and the blobs apart.
# GitHub's free LFS allowance is 1 GB of storage and 1 GB of bandwidth a month. The assets fit
# the storage comfortably; the bandwidth is the tighter limit, since every fresh clone pulls the
# lot. Compressing the textures (see reference-assets/README.md) buys headroom on both.
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.ktx2  filter=lfs diff=lfs merge=lfs -text
*.basis filter=lfs diff=lfs merge=lfs -text
# Textures. The small UI svgs stay in git proper — they are text and worth diffing.
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
# Audio, for when any is added; everything in the game is synthesised today.
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
# Small binaries that stay in git, but must not be treated as text.
*.ico   binary
*.woff2 binary
